# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
APP_SECRET=change-me-to-a-random-32-char-string

# ─── Database (SQLite para dev, PostgreSQL para prod) ──────────────────────────
DATABASE_URL="file:./data/wpp_bot.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/wpp_bot"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Mercado Livre ─────────────────────────────────────────────────────────────
ML_APP_ID=your_ml_app_id
ML_CLIENT_SECRET=your_ml_client_secret
ML_REDIRECT_URI=http://localhost:3333/auth/ml/callback
# Seu affiliate_id — aparece como "partner_id" no painel de afiliados do ML
ML_AFFILIATE_ID=your_affiliate_id
ML_AFFILIATE_SITE_ID=MLB   # MLB = Brasil

# ─── Encurtador de URL ─────────────────────────────────────────────────────────
# Opções: bitly | tinyurl | none
URL_SHORTENER=tinyurl
BITLY_TOKEN=your_bitly_token

# ─── IA (geração de textos variados) ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
# Modelo: gpt-4o-mini é barato e suficiente
OPENAI_MODEL=gpt-4o-mini

# ─── Anti-ban delays (ms) ─────────────────────────────────────────────────────
DELAY_MIN_MS=8000
DELAY_MAX_MS=25000
DAILY_POST_LIMIT=50

# ─── Admin dashboard ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-esta-senha
JWT_EXPIRES_IN=7d
