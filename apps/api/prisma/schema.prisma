generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ML OAuth Tokens ──────────────────────────────────────────────────────────

// ─── Cupons (descontos via cupom de loja) ─────────────────────────────────────

model Coupon {
  id           String   @id @default(uuid())
  externalId   String   @unique // ID na origem (ML)
  code         String?  // codigo do cupom (CUPOMXYZ)
  title        String
  description  String?  @db.Text
  discount     String?  // "10% OFF", "R$ 20 OFF", etc (texto livre)
  thumbnail    String?
  url          String   // URL pra aplicar o cupom
  affiliateUrl String?  // URL com matt_word
  store        String?  // Nome da loja/categoria
  category     String?
  validUntil   DateTime?
  fetchedAt    DateTime @default(now())

  sentCoupons SentCoupon[]
}

model SentCoupon {
  id         String   @id @default(uuid())
  couponId   String
  groupId    String
  campaignId String?  // opcional - cupons podem ser enviados manualmente
  sessionId  String
  message    String   @db.Text
  sentAt     DateTime @default(now())
  status     String   @default("sent") // sent | failed
  error      String?  @db.Text

  coupon   Coupon          @relation(fields: [couponId], references: [id])
  group    WhatsAppGroup   @relation(fields: [groupId], references: [id])
  session  WhatsAppSession @relation(fields: [sessionId], references: [id])
  campaign Campaign?       @relation(fields: [campaignId], references: [id])

  @@unique([couponId, groupId])
  @@index([sentAt])
}

model AppLog {
  id        String   @id @default(uuid())
  level     String   // info | warn | error | debug
  source    String   // crawler | campaign | whatsapp | linkgen | system
  message   String   @db.Text
  meta      String?  @db.Text // JSON serializado
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([source])
}

model MLToken {
  id           String   @id @default(uuid())
  mlUserId     String   @unique // ID do usuario no Mercado Livre
  nickname     String?
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── WhatsApp Sessions ────────────────────────────────────────────────────────

model WhatsAppSession {
  id          String   @id @default(uuid())
  name        String   @unique
  status      String   @default("disconnected") // connected | disconnected | qr_pending
  phoneNumber String?
  qrCode      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups      WhatsAppGroup[]
  sentPosts   SentPost[]
  sentCoupons SentCoupon[]
}

// ─── WhatsApp Groups / Channels ───────────────────────────────────────────────

model WhatsAppGroup {
  id          String   @id @default(uuid())
  jid         String   // WhatsApp JID (ex: 120363xxxxxxxx@g.us)
  name        String
  active      Boolean  @default(true)
  dailyLimit  Int      @default(10)
  sessionId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  campaigns   CampaignGroup[]
  sentPosts   SentPost[]
  sentCoupons SentCoupon[]

  @@unique([jid, sessionId])
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id            String   @id @default(uuid())
  provider      String   @default("ml") // ml | shopee | amazon (futuro)
  mlId          String   @unique  // ID do produto na origem (ML ou Shopee)
  title         String
  originalPrice Float?
  salePrice     Float
  discount      Int?     // percentual
  thumbnail     String?
  permalink     String
  affiliateUrl  String?
  freeShipping  Boolean  @default(false)
  category      String?
  seller        String?
  rating        Float?
  soldCount     Int?
  fetchedAt     DateTime @default(now())

  sentPosts SentPost[]
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id           String   @id @default(uuid())
  name         String
  active       Boolean  @default(true)
  keywords     String   // JSON array serializado
  categories   String   // JSON array serializado
  minDiscount  Int      @default(0)
  maxPrice     Float?
  minPrice     Float?
  freeShipping Boolean  @default(false)
  cronExpr     String   @default("0 */2 * * *") // a cada 2h
  templateType String   @default("standard")   // standard | hype | minimal | flash | coupon | social-profile
  contentType  String   @default("product")    // product | coupon | mixed | social-profile
  provider     String   @default("ml")          // ml | shopee | amazon
  useAI        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groups      CampaignGroup[]
  sentPosts   SentPost[]
  sentCoupons SentCoupon[]
  schedules   Schedule[]
}

model CampaignGroup {
  campaignId String
  groupId    String

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([campaignId, groupId])
}

// ─── Schedules ────────────────────────────────────────────────────────────────

model Schedule {
  id         String   @id @default(uuid())
  campaignId String
  runAt      DateTime
  status     String   @default("pending") // pending | running | done | failed
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ─── Sent Posts (log + dedup) ─────────────────────────────────────────────────

model SentPost {
  id         String   @id @default(uuid())
  productId  String
  groupId    String
  campaignId String
  sessionId  String
  message    String
  sentAt     DateTime @default(now())
  status     String   @default("sent") // sent | failed
  error      String?
  clicks     Int      @default(0)

  product  Product         @relation(fields: [productId], references: [id])
  group    WhatsAppGroup   @relation(fields: [groupId], references: [id])
  campaign Campaign        @relation(fields: [campaignId], references: [id])
  session  WhatsAppSession @relation(fields: [sessionId], references: [id])

  @@unique([productId, groupId])
}
